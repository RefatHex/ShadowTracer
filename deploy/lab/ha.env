# "ha" profile: second ClickHouse replica, worker1/worker2 and their shippers.
# Off by default (lab memory budget, DEV_SETUP.md). Chaos/failover scripts enable it:
#   docker compose --env-file .env --env-file ha.env up -d
# then run create-clickhouse-schema.sh once so ch-clickhouse-2 has every table.
COMPOSE_PROFILES=ha
CH_CLUSTER_XML=cluster.xml
CLICKHOUSE_HOSTS=ch-clickhouse-1:8123,ch-clickhouse-2:8123
SHIPPER_METRICS_URLS=http://shipper-master:9101,http://shipper-worker1:9101,http://shipper-worker2:9101
