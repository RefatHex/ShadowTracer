# Copy to .env (gitignored) and fill in real values before running the lab.
#   cp deploy/lab/.env.example deploy/lab/.env

# 32 hex chars, shared by all 3 cluster nodes. Generate with:
#   openssl rand -hex 16
CLUSTER_KEY=

# Password agents use to enroll with the master (authd). Generate with:
#   openssl rand -base64 18
ENROLL_PASSWORD=

# Free, non-commercial VirusTotal API key, for the lab-only VT integration
# test (Step 3, item 11). Leave blank to skip that test.
VT_API_KEY=

# --- Phase 3 data platform ---

# Kafka KRaft cluster id (base64, 16 random bytes). Generate with:
#   python3 -c "import uuid,base64;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
KAFKA_CLUSTER_ID=

CLICKHOUSE_USER=shadowtracer
# Generate with: openssl rand -base64 18
CLICKHOUSE_PASSWORD=

POSTGRES_USER=shadowtracer
# Generate with: openssl rand -base64 18
POSTGRES_PASSWORD=
POSTGRES_DB=shadowtracer

# --- Phase 4 console ---

# JWT signing secret - refused at startup if missing, a known placeholder,
# or under 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# shadowtracer_app is a separate, restricted PostgreSQL role the console
# backend actually connects as (POSTGRES_USER/PASSWORD above remain the
# table-owning role, used for migrations and admin/CLI access) - created
# by the Phase 4 auth-roles migration, which grants it SELECT/INSERT/
# UPDATE/DELETE on the ordinary tables but SELECT/INSERT ONLY on
# audit_log. Generate with: openssl rand -base64 24
APP_DB_PASSWORD=

# Explicit CORS allowlist for the console API - comma-separated origins,
# no wildcard. The lab's Caddy-fronted console origin (Step 7).
CORS_ALLOW_ORIGINS=https://localhost:8443

# smoke-test.sh's end-to-end alert check logs in as this user - it never
# creates one itself (no default admin, Step 2). Create it once with:
#   cd shadowtracer/console/backend && python cli.py create-admin --tenant lab --email <email>
# then fill in the same email/password here. Leave blank to skip that
# part of the smoke test.
SMOKE_TEST_ADMIN_EMAIL=
SMOKE_TEST_ADMIN_PASSWORD=

# --- Phase 4 follow-ups ---

# The "lab" tenant's permanent tenant_key, printed by the create-admin
# command above - required for the shipper-worker1/shipper-worker2
# compose services to start (follow-up 2: the shipper is given this as
# TENANT_ID, so it stamps ClickHouse events with the same identity the
# console's tokens carry - follow-up 1). Run create-admin once (it prints
# the tenant_key), set it here, then `docker compose up` the shippers.
TENANT_KEY=

# --- Phase 5C Step 0, item 3: dedicated lab test tenant ---
# Every automated script that generates real pipeline traffic (smoke-test.sh's
# real SSH brute-force + hostile-input injection, verify-correlator-chaos.sh's
# synthesized chaos alerts) ships under THIS tenant, never TENANT_KEY above -
# the main lab tenant must stay clean of test-generated incidents. Required
# for shipper-worker-test and agent-ubuntu-1 (re-pointed at wazuh-worker-test,
# bypassing the shared LB) to start. Create the same way as the main tenant:
#   cd shadowtracer/console/backend && python cli.py create-admin \
#     --tenant shadowtracer-lab-test --email <email>
TEST_TENANT_KEY=
TEST_TENANT_ADMIN_EMAIL=
TEST_TENANT_ADMIN_PASSWORD=
