# Copy to .env (gitignored) and fill in real values before running the lab.
#   cp deploy/lab/.env.example deploy/lab/.env

# 32 hex chars, shared by all 3 cluster nodes. Generate with:
#   openssl rand -hex 16
CLUSTER_KEY=

# Password agents use to enroll with the master (authd). Generate with:
#   openssl rand -base64 18
ENROLL_PASSWORD=

# Free, non-commercial VirusTotal API key, for the lab-only VT integration
# test (Step 3, item 11). Leave blank to skip that test.
VT_API_KEY=

# --- Phase 3 data platform ---

# Kafka KRaft cluster id (base64, 16 random bytes). Generate with:
#   python3 -c "import uuid,base64;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
KAFKA_CLUSTER_ID=

CLICKHOUSE_USER=shadowtracer
# Generate with: openssl rand -base64 18
CLICKHOUSE_PASSWORD=

POSTGRES_USER=shadowtracer
# Generate with: openssl rand -base64 18
POSTGRES_PASSWORD=
POSTGRES_DB=shadowtracer
