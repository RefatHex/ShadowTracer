<clickhouse>
    <!-- Durability on this lab host. ClickHouse defaults to no fsync for
         parts; the host hard-resets in power outages, and twice (2026-11-02,
         2026-11-04) parts written in the last seconds came back as 0-byte
         files on BOTH replicas at once - they share one disk, so replication
         is no protection against a host-wide reset. See
         docs/THROUGHPUT_BASELINE.md section 11. -->
    <merge_tree>
        <fsync_after_insert>1</fsync_after_insert>
        <fsync_part_directory>1</fsync_part_directory>
        <min_compressed_bytes_to_fsync_after_merge>1</min_compressed_bytes_to_fsync_after_merge>
        <min_compressed_bytes_to_fsync_after_fetch>1</min_compressed_bytes_to_fsync_after_fetch>
    </merge_tree>
</clickhouse>
