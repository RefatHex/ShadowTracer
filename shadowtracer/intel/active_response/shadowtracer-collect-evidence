#!/bin/bash
# ShadowTracer collect-evidence active-response (Phase 9 d). Runs on the AGENT via the
# !shadowtracer-collect-evidence API form. Shell (agents have no python3). READ-ONLY: snapshots running
# processes, network connections and recent logins, and writes a one-line JSON record to a log the
# agent's logcollector ships back, where a ShadowTracer rule attaches it to the incident. Runs before
# disable/quarantine so the analyst has the host state. Never changes anything (so: no reverse).
#   extra_args = ["collect","<tag>"]   (tag is echoed back for correlation)
set -u
read -r MSG || MSG=""
arg() { printf '%s' "$MSG" | sed -n 's/.*"extra_args":\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | sed -n "${1}p" | tr -d '"'; }
TAG=$(arg 2)
OUT="${ST_EVIDENCE_LOG:-/var/ossec/logs/shadowtracer-evidence.log}"
CAP="${ST_EVIDENCE_CAP:-200}"

# JSON-escape a block of text into a single-line array of strings (bounded to CAP lines).
json_lines() { head -n "$CAP" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'BEGIN{p=""}{printf "%s\"%s\"",p,$0;p=","}'; }

procs=$(ps -eo pid,user,comm,args --sort=-pcpu 2>/dev/null | json_lines)
conns=$(ss -tunap 2>/dev/null | json_lines)
logins=$(last -n 20 2>/dev/null | json_lines)
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

printf '{"shadowtracer_evidence":true,"tag":"%s","collected_at":"%s","processes":[%s],"connections":[%s],"recent_logins":[%s]}\n' \
  "$TAG" "$ts" "$procs" "$conns" "$logins" >> "$OUT" 2>/dev/null
exit 0
