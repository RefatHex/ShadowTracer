#!/bin/bash
# ShadowTracer firewall active-response (Phase 9 SOAR; agent-side expiry A3). Runs on the AGENT,
# invoked by Wazuh active response over the API !shadowtracer-fw-drop form. Shell (not Python) because
# minimal agents have no python3. The action is the FIRST extra_arg, so the SAME script both applies
# and REVERSES a block through the API:
#   extra_args = ["add","<ip>","<ttl_seconds>"]  apply a timed block
#              = ["delete","<ip>"]                reverse now
#              = ["sweep"]                         remove blocks whose TTL elapsed
# Agent-side expiry (A3): every timed block is recorded in a local manifest ("<ip> <expiry_epoch>"
# per line) and the script removes due blocks ITSELF on every invocation and when a periodic Wazuh
# command wodle calls it with "sweep" — so a block lifts on time even if the SOAR worker is dead; the
# worker's own sweep stays as a second timer. Private/loopback IPs are refused (defence in depth).
set -u
IPTABLES="${ST_IPTABLES:-/sbin/iptables}"
[ -x "$IPTABLES" ] || IPTABLES=iptables
MANIFEST="${ST_FW_MANIFEST:-/var/ossec/active-response/shadowtracer-fw.json}"

read -r MSG || MSG=""
field() { printf '%s' "$MSG" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" | head -1; }
# extra_args array -> nth element (1-based)
arg() { printf '%s' "$MSG" | sed -n 's/.*"extra_args":\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | sed -n "${1}p" | tr -d '"'; }

ACTION=$(arg 1); [ -n "$ACTION" ] || ACTION=add
IP=$(field srcip); [ -n "$IP" ] || IP=$(arg 2)
TTL=$(arg 3)
NOW=$(date +%s)

present() { $IPTABLES -C INPUT -s "$1" -j DROP 2>/dev/null; }
add_rule() { present "$1" || $IPTABLES -I INPUT 1 -s "$1" -j DROP 2>/dev/null; }
del_rule() { while present "$1"; do $IPTABLES -D INPUT -s "$1" -j DROP 2>/dev/null || break; done; }

# self-sweep: drop rules whose expiry has passed, rewrite the manifest with survivors
sweep() {
  [ -f "$MANIFEST" ] || return 0
  tmp="$MANIFEST.tmp"; : > "$tmp"
  while read -r mip mexp; do
    [ -n "$mip" ] || continue
    if [ -n "$mexp" ] && [ "$mexp" != "0" ] && [ "$NOW" -ge "$mexp" ]; then
      del_rule "$mip"
    else
      printf '%s %s\n' "$mip" "$mexp" >> "$tmp"
    fi
  done < "$MANIFEST"
  mv -f "$tmp" "$MANIFEST" 2>/dev/null || rm -f "$tmp"
}

manifest_set() {  # ip expiry
  touch "$MANIFEST"
  grep -v "^$1 " "$MANIFEST" > "$MANIFEST.tmp" 2>/dev/null || : > "$MANIFEST.tmp"
  printf '%s %s\n' "$1" "$2" >> "$MANIFEST.tmp"
  mv -f "$MANIFEST.tmp" "$MANIFEST"
}
manifest_del() {
  [ -f "$MANIFEST" ] || return 0
  grep -v "^$1 " "$MANIFEST" > "$MANIFEST.tmp" 2>/dev/null; mv -f "$MANIFEST.tmp" "$MANIFEST"
}

sweep

[ "$ACTION" = sweep ] && exit 0

# agent-side allowlist guard: never block private / loopback / link-local / multicast
case "$IP" in
  ''|10.*|127.*|169.254.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*|22[4-9].*|23*.*) exit 0 ;;
esac

if [ "$ACTION" = delete ]; then
  del_rule "$IP"; manifest_del "$IP"
else
  add_rule "$IP"
  if [ -n "$TTL" ] && [ "$TTL" -gt 0 ] 2>/dev/null; then manifest_set "$IP" "$((NOW + TTL))"; else manifest_set "$IP" 0; fi
fi
exit 0
