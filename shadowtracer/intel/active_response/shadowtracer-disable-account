#!/bin/bash
# ShadowTracer disable-account active-response (Phase 9 d). Runs on the AGENT via the
# !shadowtracer-disable-account API form. Shell (agents have no python3). Locks or unlocks a LOCAL
# account, reversible through the API because the verb is the first extra_arg:
#   extra_args = ["disable"|"enable","<username>"]
# The username is validated (POSIX charset) and a built-in allowlist of system/service accounts is
# refused (defence in depth beneath SOAR's own checks). Uses usermod -L/-U + account expiry, no shell-
# interpolation of the name.
set -u
read -r MSG || MSG=""
arg() { printf '%s' "$MSG" | sed -n 's/.*"extra_args":\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | sed -n "${1}p" | tr -d '"'; }
VERB=$(arg 1); USERN=$(arg 2)
USERMOD=/usr/sbin/usermod; [ -x "$USERMOD" ] || USERMOD=usermod

# valid POSIX name and not a protected account
case "$USERN" in
  ''|*[!a-z0-9_-]*) exit 0 ;;
  root|daemon|bin|sys|sync|wazuh|ossec|sshd|systemd-*) exit 0 ;;
esac
id "$USERN" >/dev/null 2>&1 || exit 0     # account must exist

if [ "$VERB" = enable ]; then
  "$USERMOD" -U "$USERN" 2>/dev/null
  "$USERMOD" -e "" "$USERN" 2>/dev/null   # clear expiry
else
  "$USERMOD" -L "$USERN" 2>/dev/null
  "$USERMOD" -e 1970-01-02 "$USERN" 2>/dev/null
fi
exit 0
