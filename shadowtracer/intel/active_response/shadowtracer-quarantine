#!/bin/bash
# ShadowTracer quarantine active-response (Phase 9 d). Runs on the AGENT via the
# !shadowtracer-quarantine API form. Shell (agents have no python3). Moves a flagged file into a 0600
# quarantine store (keeping its sha256 and original path in a manifest) or restores it — reversible
# through the API because the verb is the first extra_arg:
#   extra_args = ["quarantine"|"restore","<path>"]
# Safety: the path must resolve inside a FIM-monitored root, or the move is refused (no traversal /
# symlink escape to a system location). The agent-side manifest is what restore reads, so SOAR keeps
# no server-side copy of the hash.
set -u
read -r MSG || MSG=""
arg() { printf '%s' "$MSG" | sed -n 's/.*"extra_args":\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | sed -n "${1}p" | tr -d '"'; }
VERB=$(arg 1); P=$(arg 2)
QDIR="${ST_QUARANTINE_DIR:-/var/ossec/quarantine}"
MANIFEST="$QDIR/manifest"
FIM_ROOTS="/etc /usr/bin /usr/sbin /bin /sbin /usr/local/bin /opt /root /home /tmp /var/tmp /dev/shm /srv/www /var/www"

[ -n "$P" ] || exit 0
mkdir -p "$QDIR" 2>/dev/null; chmod 700 "$QDIR" 2>/dev/null

if [ "$VERB" = restore ]; then
  line=$(grep -F " $P" "$MANIFEST" 2>/dev/null | tail -1)   # "<sha> <stored> <path>"
  stored=$(printf '%s' "$line" | awk '{print $2}')
  if [ -n "$stored" ] && [ -f "$stored" ]; then
    mv -f "$stored" "$P" 2>/dev/null
    grep -vF " $P" "$MANIFEST" > "$MANIFEST.t" 2>/dev/null; mv -f "$MANIFEST.t" "$MANIFEST" 2>/dev/null
  fi
  exit 0
fi

# quarantine: file must exist and resolve inside a monitored root
[ -f "$P" ] || exit 0
rp=$(readlink -f "$P" 2>/dev/null); [ -n "$rp" ] || exit 0
inside=0
for d in $FIM_ROOTS; do case "$rp" in "$d"|"$d"/*) inside=1;; esac; done
[ "$inside" = 1 ] || exit 0

sha=$(sha256sum "$P" 2>/dev/null | awk '{print $1}'); [ -n "$sha" ] || exit 0
stored="$QDIR/$sha"
mv -f "$P" "$stored" 2>/dev/null && chmod 600 "$stored" 2>/dev/null
touch "$MANIFEST"; grep -vF " $P" "$MANIFEST" > "$MANIFEST.t" 2>/dev/null; mv -f "$MANIFEST.t" "$MANIFEST" 2>/dev/null
printf '%s %s %s\n' "$sha" "$stored" "$P" >> "$MANIFEST"
exit 0
