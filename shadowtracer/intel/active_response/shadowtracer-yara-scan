#!/bin/bash
# ShadowTracer YARA-X active-response scan (Phase 6.5 A2; rewritten to bash in Phase 9 follow-up —
# minimal agents have NO python3, so the earlier Python version could never run on them). Runs on the
# AGENT, invoked by Wazuh active response (manager -> agent execd) with an alert JSON on stdin. Scans
# ONE FIM-flagged file with YARA-X (the `yr` binary) and writes a one-line JSON result to a log the
# agent's logcollector ships back, where a ShadowTracer rule turns a match into a TI alert.
#
# Safety: the target path must resolve (symlinks followed) inside a FIM-monitored root, or the scan is
# refused (no traversal / symlink escape). The file is re-hashed first; if its sha256 no longer matches
# the hash the alert carried, "changed"/"gone" is reported instead of scanning a different file. No
# shell-interpolation of the path; the scan runs niced, under a wall-clock timeout, and skips oversize
# files.
set -u
YR="${ST_YARA_BIN:-/usr/local/bin/yr}"; command -v "$YR" >/dev/null 2>&1 || YR=yr
RULES="${ST_YARA_RULES:-/var/ossec/etc/shared/shadowtracer-yara/compiled.yarc}"
OUT="${ST_YARA_LOG:-/var/ossec/logs/shadowtracer-yara.log}"
SIZE_CAP="${ST_YARA_SIZE_CAP:-33554432}"
TIMEOUT="${ST_YARA_TIMEOUT:-60}"
CPU_LIMIT="${ST_YARA_CPU_LIMIT:-60}"
FIM_DIRS="${ST_YARA_FIM_DIRS:-/etc /usr/bin /usr/sbin /bin /sbin /usr/lib /usr/local/bin /usr/local/sbin /opt /root /home /tmp /var/tmp /dev/shm /var/www /srv/www}"

MSG=$(cat)
jget() { printf '%s' "$MSG" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" | head -1; }
PATH_=$(jget path); [ -n "$PATH_" ] || PATH_=$(jget shadowtracer_scan_path)
EXPECT=$(jget sha256_after); [ -n "$EXPECT" ] || EXPECT=$(jget sha256); EXPECT=$(printf '%s' "$EXPECT" | tr 'A-F' 'a-f')
NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)

emit() { printf '%s\n' "$1" >> "$OUT" 2>/dev/null || printf '%s\n' "$1"; }
base() { printf '{"integration":"shadowtracer-yara","file":"%s","sha256":"%s","status":"%s","scanned_at":"%s"' "$PATH_" "$1" "$2" "$NOW"; }

# path must resolve inside a FIM-monitored root
rp=$(readlink -f "$PATH_" 2>/dev/null)
inside=0; for d in $FIM_DIRS; do case "$rp" in "$d"|"$d"/*) inside=1;; esac; done
if [ -z "$PATH_" ] || [ "$inside" != 1 ]; then
  emit "$(base "" refused),\"reason\":\"path not inside a FIM-monitored directory\"}"; exit 0
fi

actual=$(sha256sum "$PATH_" 2>/dev/null | awk '{print $1}')
if [ -z "$actual" ]; then emit "$(base "" gone)}"; exit 0; fi
if [ -n "$EXPECT" ] && [ "$actual" != "$EXPECT" ]; then
  emit "$(base "$actual" changed),\"expected_sha256\":\"$EXPECT\"}"; exit 0
fi
[ "$(stat -c %s "$PATH_" 2>/dev/null || echo 0)" -gt "$SIZE_CAP" ] && { emit "$(base "$actual" no_match)}"; exit 0; }

# scan: yr prints "<namespace>:<rule> <file>" per match on stdout
matches=$(nice -n 10 timeout "$((TIMEOUT + 15))" "$YR" scan -C --cpu-limit "$CPU_LIMIT" "$RULES" "$PATH_" 2>/dev/null \
  | awk '{print $1}' | awk -F: '{print $NF}' | sort -u)
if [ -z "$matches" ]; then emit "$(base "$actual" no_match)}"; exit 0; fi
printf '%s\n' "$matches" | while read -r rule; do
  [ -n "$rule" ] && emit "$(base "$actual" match),\"yara_rule\":\"$rule\",\"attribution\":\"YARA rule authors (DRL 1.1 / GPL-2); see rule\"}"
done
exit 0
