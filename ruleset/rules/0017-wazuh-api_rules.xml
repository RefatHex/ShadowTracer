<!--
  Wazuh API rules ID: 400 - 428
-->

<group name="wazuh_api,">

  <rule id="400" level="0">
    <decoded_as>wazuh-api</decoded_as>
    <description>Rules for ShadowTracer API events.</description>
  </rule>

  <rule id="401" level="3">
    <if_sid>400</if_sid>
    <field name="type">INFO</field>
    <description>ShadowTracer API: Informative event.</description>
  </rule>

  <rule id="402" level="5">
    <if_sid>400</if_sid>
    <field name="type">WARNING</field>
    <description>ShadowTracer API: Warning event.</description>
    <group>gpg13_4.12</group>
  </rule>

  <rule id="403" level="8">
    <if_sid>400</if_sid>
    <field name="type">ERROR</field>
    <description>ShadowTracer API: Error event.</description>
    <group>gpg13_4.3,gpg13_4.12</group>
  </rule>

  <rule id="404" level="12">
    <if_sid>400</if_sid>
    <field name="type">CRITICAL</field>
    <description>ShadowTracer API: Critical Error event, requires inmediate atention.</description>
    <group>gpg13_4.1,gpg13_4.3,gpg13_4.12,pci_dss_10.6.1,</group>
  </rule>

  <rule id="405" level="7">
    <if_sid>400</if_sid>
    <field name="http_status_code" negate="yes">200</field>
    <description>ShadowTracer API: $(endpoint) response code returned error.</description>
    <group>gpg13_4.3</group>
  </rule>

  <rule id="406" level="4">
    <if_sid>400</if_sid>
    <field name="method">GET</field>
    <description>ShadowTracer API: $(endpoint) Success.</description>
  </rule>

  <rule id="407" level="5">
    <if_sid>400</if_sid>
    <field name="method">PUT</field>
    <description>ShadowTracer API:$(endpoint) Success.</description>
  </rule>

  <rule id="408" level="7">
    <if_sid>400</if_sid>
    <field name="method">DELETE</field>
    <description>ShadowTracer API: $(endpoint) Success.</description>
    <group>hipaa_164.312.a.2.I,hipaa_164.312.c.1,pci_dss_8.1.2,</group>
  </rule>

  <rule id="409" level="5">
    <if_sid>400</if_sid>
    <field name="method">POST</field>
    <description>ShadowTracer API: $(endpoint) Success.</description>
    <group>hipaa_164.312.c.1</group>
  </rule>

  <rule id="410" level="4">
    <if_sid>405</if_sid>
    <field name="http_status_code">400</field>
    <description>ShadowTracer API: $(endpoint) Bad request.</description>
  </rule>

  <rule id="411" level="8">
    <if_sid>405</if_sid>
    <field name="http_status_code">401</field>
    <description>ShadowTracer API: $(endpoint) Unauthorized.</description>
    <group>gpg13_4.3,tsc_cc6.8,hipaa_164.312.e.1</group>
  </rule>

  <rule id="412" level="7">
    <if_sid>405</if_sid>
    <field name="http_status_code">403</field>
    <description>ShadowTracer API: $(endpoint) Permission denied.</description>
    <group>gpg13_4.3,hipaa_164.312.e.1,nist_800_53_AC.7,pci_dss_7.1,pci_dss_10.2.4,tsc_cc6.8,</group>
  </rule>

  <rule id="413" level="4">
    <if_sid>405</if_sid>
    <field name="http_status_code">404</field>
    <description>ShadowTracer API: $(endpoint) Resource not found.</description>
  </rule>

  <rule id="414" level="4">
    <if_sid>405</if_sid>
    <field name="http_status_code">405</field>
    <description>ShadowTracer API: $(endpoint) Invalid HTTP method.</description>
  </rule>

  <rule id="415" level="4">
    <if_sid>405</if_sid>
    <field name="http_status_code">406</field>
    <description>ShadowTracer API: $(endpoint) Invalid content-type.</description>
  </rule>

  <rule id="416" level="4">
    <if_sid>405</if_sid>
    <field name="http_status_code">413</field>
    <description>ShadowTracer API: $(endpoint) Maximum request body size exceeded.</description>
  </rule>

  <rule id="417" level="7">
    <if_sid>405</if_sid>
    <field name="http_status_code">429</field>
    <description>ShadowTracer API: $(endpoint) Max number of requests per minute reached.</description>
    <group>gpg13_4.3,tsc_cc6.8,hipaa_164.312.e.1,nist_800_53_AC.7,pci_dss_7.1,pci_dss_8.1.6,pci_dss_10.2.4,</group>
  </rule>

  <rule id="418" level="4">
    <if_sid>405</if_sid>
    <field name="http_status_code">500</field>
    <description>ShadowTracer API: $(endpoint) Internal error.</description>
  </rule>

  <rule id="420" level="0">
    <decoded_as>wazuh-api-info</decoded_as>
    <description>Rules for ShadowTracer API events.</description>
  </rule>

  <rule id="421" level="3">
    <if_sid>420</if_sid>
    <field name="type">INFO</field>
    <description>ShadowTracer API: Informative event.</description>
    <group>gpg13_3.3,gpg13_7.1,hipaa_164.312.a.1,nist_800_53_AC.7,nist_800_53_SC.5,pci_dss_1.3.2,pci_dss_6.5.10,pci_dss_7.1,pci_dss_8.1,tsc_cc6.1,</group>
  </rule>

  <rule id="422" level="5">
    <if_sid>420</if_sid>
    <field name="type">WARNING</field>
    <description>ShadowTracer API Warning event.</description>
    <group>gpg13_3.3,gpg13_4.12,gpg13_7.1,hipaa_164.312.a.1,nist_800_53_AC.7,nist_800_53_SC.5,pci_dss_1.3.2,pci_dss_6.5.10,pci_dss_7.1,pci_dss_8.1,tsc_cc6.1,</group>
  </rule>

  <rule id="423" level="8">
    <if_sid>420</if_sid>
    <field name="type">ERROR</field>
    <description>ShadowTracer API Error event.</description>
    <group>gpg13_3.3,gpg13_7.1,gpg13_4.12,gpg13_4.3,hipaa_164.312.a.1,nist_800_53_AC.7,nist_800_53_SC.5,pci_dss_1.3.2,pci_dss_6.5.10,pci_dss_7.1,pci_dss_8.1,tsc_cc6.1,</group>
  </rule>

  <rule id="424" level="12">
    <if_sid>420</if_sid>
    <field name="type">CRITICAL</field>
    <description>ShadowTracer API Critical error event, requires inmediate atention.</description>
    <group>gpg13_3.3,gpg13_7.1,gpg13_4.12,gpg13_4.3,hipaa_164.312.a.1,nist_800_53_AC.7,nist_800_53_SC.5,pci_dss_10.6.1,gpg13_4.1,pci_dss_1.3.2,pci_dss_6.5.10,pci_dss_7.1,pci_dss_8.1,tsc_cc6.1,</group>
  </rule>

  <rule id="425" level="7">
    <if_sid>400,410</if_sid>
    <field name="uri">/security/user/authenticate</field>
    <description>Authentication Attempt.</description>
  </rule>

  <rule id="426" level="4">
    <if_sid>425</if_sid>
    <field name="http_status_code">200</field>
    <description>ShadowTracer API: Authentication success from $(srcip)</description>
    <group>hipaa_164.312.d,pci_dss_8.2</group>
  </rule>

  <rule id="427" level="7">
    <if_sid>425</if_sid>
    <field name="http_status_code" negate="yes">200</field>
    <description>ShadowTracer API: Authentication failure from $(srcip)</description>
    <group>gpg13_3.3,hipaa_164.312.e.1,nist_800_53_AC.7,pci_dss_8.2</group>
  </rule>

  <rule id="428" level="10">
    <if_sid>420</if_sid>
    <match>IP blocked due to exceeded number of logins attempts</match>>
    <description>ShadowTracer API: Warning event - IP: $(srcip) blocked due to exceeded loging attemps.</description>
    <group>gpg13_3.3,hipaa_164.312.e.1,nist_800_53_AC.7,pci_dss_8.2</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
