.git
node_modules
dist
datasets
.env
build
*.log

# Stray host-side Wazuh build output. Never ship it into a build context:
# a leftover CMakeCache.txt baked with a different absolute path breaks
# cmake ("source does not match the source used to generate cache").
src/build/
src/external/*
src/**/build/
*.o
*.a
*.so
src/agent-auth
src/agent_control
deploy/lab/.env

# Mounted at runtime via docker-compose volumes instead (PHASE1_FINDINGS.md
# next-session rule 1) - keep these out of the build context so editing them
# doesn't bust the COPY . . layer cache and force a full recompile.
deploy/lab/entrypoint-*.sh
deploy/lab/healthcheck-*.sh
deploy/lab/docker-compose.yml
deploy/lab/haproxy.cfg
